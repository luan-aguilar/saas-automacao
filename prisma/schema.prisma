// Schema Prisma — Plataforma de Automação de Robôs de WhatsApp (Multi-Tenant)
// Cada usuário CLIENTE é um "tenant": possui sua própria Config, WhatsappConnection,
// Flows e Chats. O usuário MASTER gerencia os tenants e também pode operar seu
// próprio robô (por isso Config/WhatsappConnection/Flow/Chat pertencem a User,
// independente do role).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  MASTER
  CLIENTE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum WhatsappStatus {
  DISCONNECTED
  CONNECTING
  QR_PENDING
  CONNECTED
  ERROR
}

enum ChatStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CONTACT
  AI
  HUMAN
  SYSTEM
}

enum FlowNodeType {
  TRIGGER
  AI_RESPONSE
  STATIC_MESSAGE
  CONDITION
}

enum FlowSessionStatus {
  ACTIVE
  WAITING_INPUT
  COMPLETED
}

// ---------------------------------------------------------------------------
// Usuários / RBAC
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         Role       @default(CLIENTE)
  status       UserStatus @default(ACTIVE)

  // Indica se o usuário ainda está usando a senha temporária gerada pelo MASTER
  mustChangePassword Boolean @default(true)

  // Quem (MASTER) criou esta conta de cliente
  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  config             Config?
  whatsappConnection WhatsappConnection?
  flows              Flow[]
  flowSessions       FlowSession[]
  chats              Chat[]
  auditLogs          AuditLog[]

  // Templates pré-definidos (Salão de Beleza, Energia Solar, etc.) liberados
  // para este cliente pelo MASTER — ver `TemplateAccess`.
  templateAccess TemplateAccess[] @relation("TemplateAccessUser")
  templateGrants TemplateAccess[] @relation("TemplateAccessGrantedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Acesso a templates pré-definidos (Salão de Beleza, Energia Solar, etc.)
// ---------------------------------------------------------------------------
// Os templates em si são definidos em código (`src/lib/templates/registry.ts`),
// não no banco — este modelo só controla QUAIS clientes podem carregar QUAL
// template no Construtor de Fluxos. O MASTER sempre tem acesso a todos
// (não precisa de linha aqui); um CLIENTE só vê o botão de um template no
// Construtor se existir uma linha liberando aquele `templateKey` para ele.

model TemplateAccess {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("TemplateAccessUser", fields: [userId], references: [id], onDelete: Cascade)

  // Chave estável do template no registry (ex: "beauty-salon"), não um FK —
  // o catálogo de templates vive em código, não em tabela própria.
  templateKey String

  grantedById String?
  grantedBy   User?   @relation("TemplateAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, templateKey])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Configurações do robô (por cliente/tenant)
// ---------------------------------------------------------------------------

model Config {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // API Key da OpenAI do cliente, armazenada criptografada (AES-256-GCM) — nunca em texto puro
  openaiApiKeyEncrypted String?
  openaiApiKeyLast4     String? // últimos 4 caracteres, só para exibição ("sk-...ab12")

  // Prompt de sistema geral do robô
  systemPrompt String @default("Você é um assistente virtual educado e objetivo. Responda de forma clara e curta.")

  model            String  @default("gpt-4o-mini")
  temperature      Float   @default(0.7)
  aiEnabledDefault Boolean @default(true) // valor padrão do toggle de IA para novas conversas

  // Chave geral de IA do tenant: quando false, o motor de fluxo NÃO responde
  // a ninguém automaticamente — nem contatos novos — independente do
  // `Chat.aiEnabled` de cada conversa individual. É o "disjuntor mestre";
  // os toggles por conversa continuam existindo por baixo, só não têm efeito
  // enquanto esta chave estiver desligada.
  aiGloballyEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Conexão com o WhatsApp (pareamento via QR Code)
// ---------------------------------------------------------------------------

model WhatsappConnection {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      WhatsappStatus @default(DISCONNECTED)
  phoneNumber String?

  // QR code atual (data URL base64), atualizado pelo serviço externo (Baileys/whatsapp-web.js)
  // via webhook -> POST /api/whatsapp/qr
  qrCode      String? @db.Text
  qrExpiresAt DateTime?

  // Identificador da sessão no serviço externo responsável por manter o socket com o WhatsApp
  externalSessionId String?

  lastConnectedAt    DateTime?
  lastDisconnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Fluxos visuais (React Flow) — estilo n8n
// ---------------------------------------------------------------------------

model Flow {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean @default(false)

  // Estrutura completa do React Flow (nodes + edges) serializada como JSON
  nodes Json @default("[]")
  edges Json @default("[]")

  version Int @default(1)

  sessions FlowSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Sessão de fluxo — posição de cada contato dentro do grafo de um Flow
// ---------------------------------------------------------------------------

model FlowSession {
  id     String @id @default(cuid())
  userId String // tenant dono do fluxo/conexão de WhatsApp
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  flowId String
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)

  contactPhone String // número do contato (com DDI), ex: "5511999998888"

  // Id do node do React Flow onde o contato está parado (null = ainda não iniciou)
  currentNodeId String?

  // Variáveis capturadas ao longo da conversa (ex: { nome: "Maria", servico: "Corte" })
  variables Json @default("{}")

  status FlowSessionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um contato tem no máximo uma sessão ativa por tenant
  @@unique([userId, contactPhone])
  @@index([userId, status])
  @@index([flowId])
}

// ---------------------------------------------------------------------------
// Live Chat / Central de Atendimento
// ---------------------------------------------------------------------------

model Chat {
  id     String @id @default(cuid())
  userId String // tenant dono da conversa
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contactName  String
  contactPhone String
  contactAvatarUrl String?

  status ChatStatus @default(OPEN)

  // Toggle por conversa: quando false, a IA para de responder e um humano assume
  aiEnabled Boolean @default(true)

  lastMessageAt DateTime  @default(now())
  lastMessagePreview String?
  unreadCount   Int       @default(0)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um contato tem no máximo uma conversa por tenant (usado por flow-engine.ts
  // para localizar/criar a conversa ao receber uma mensagem via webhook).
  @@unique([userId, contactPhone])
  @@index([userId, status])
  @@index([userId, lastMessageAt])
}

model Message {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  direction MessageDirection
  sender    MessageSender
  content   String           @db.Text
  mediaUrl  String?

  // ID da mensagem no provedor do WhatsApp (para status de entrega/leitura)
  externalId String?

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

// ---------------------------------------------------------------------------
// Auditoria (ex: MASTER criou/desativou cliente, resetou senha, etc.)
// ---------------------------------------------------------------------------

model AuditLog {
  id     String @id @default(cuid())
  userId String // quem executou a ação (geralmente um MASTER)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  action  String // ex: "CLIENT_CREATED", "CLIENT_DEACTIVATED", "PASSWORD_RESET"
  target  String? // id do recurso afetado
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
}
