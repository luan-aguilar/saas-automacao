// Schema Prisma — Plataforma de Automação de Robôs de WhatsApp (Multi-Tenant)
// Cada usuário CLIENTE é um "tenant": possui sua própria Config, WhatsappConnection,
// Flows e Chats. O usuário MASTER gerencia os tenants e também pode operar seu
// próprio robô (por isso Config/WhatsappConnection/Flow/Chat pertencem a User,
// independente do role).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  MASTER
  CLIENTE
  // Conta de equipe (ex: recepcionista) criada pelo próprio dono do tenant
  // (um CLIENTE) — ver `User.tenantOwnerId`. Enxerga e opera os mesmos dados
  // do dono (chats, funil), mas sem acesso ao Construtor de Fluxos, sem
  // poder excluir conversas, e com todas as ações registradas em `AuditLog`.
  FUNCIONARIO
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum WhatsappStatus {
  DISCONNECTED
  CONNECTING
  QR_PENDING
  CONNECTED
  ERROR
}

enum ChatStatus {
  OPEN
  CLOSED
  ARCHIVED
}

// Funil/pipeline de atendimento (quadro Kanban em /pipeline) — em qual etapa
// do processo comercial está o contato. Independente de `ChatStatus` (que é
// sobre a conversa em si estar aberta/fechada); este é sobre onde o LEAD está
// no funil de vendas.
enum PipelineStage {
  PRIMEIRO_ATENDIMENTO // conversa nova, IA conduzindo o atendimento inicial
  CLIENTE_RECORRENTE // já concluiu o funil antes (AGENDAMENTO_CONCLUIDO) e voltou pra um novo atendimento
  AGUARDANDO_HUMANO // IA coletou os dados e encaminhou para um atendente humano finalizar
  AGENDAMENTO_CONCLUIDO // movido manualmente por um operador quando o agendamento/venda é fechado
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CONTACT
  AI
  HUMAN
  SYSTEM
}

enum FlowNodeType {
  TRIGGER
  AI_RESPONSE
  STATIC_MESSAGE
  CONDITION
}

enum FlowSessionStatus {
  ACTIVE
  WAITING_INPUT
  COMPLETED
}

// ---------------------------------------------------------------------------
// Usuários / RBAC
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         Role       @default(CLIENTE)
  status       UserStatus @default(ACTIVE)

  // Indica se o usuário ainda está usando a senha temporária gerada pelo MASTER
  mustChangePassword Boolean @default(true)

  // Quem (MASTER, ou o dono do tenant no caso de um FUNCIONARIO) criou esta conta
  createdById String?
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  // Preenchido somente para role FUNCIONARIO: aponta pro CLIENTE dono do
  // tenant cujos dados (chats, fluxos, config, conexão WhatsApp) este
  // funcionário deve enxergar/operar — ver `src/lib/tenant.ts`. Nulo para
  // MASTER e CLIENTE (donos de tenant usam o próprio id como escopo).
  tenantOwnerId String?
  tenantOwner   User?   @relation("TenantEmployees", fields: [tenantOwnerId], references: [id], onDelete: Cascade)
  employees     User[]  @relation("TenantEmployees")

  config             Config?
  whatsappConnection WhatsappConnection?
  googleIntegration  GoogleIntegration?
  flows              Flow[]
  flowSessions       FlowSession[]
  chats              Chat[]
  auditLogs          AuditLog[]

  // Templates pré-definidos (Salão de Beleza, Energia Solar, etc.) liberados
  // para este cliente pelo MASTER — ver `TemplateAccess`.
  templateAccess TemplateAccess[] @relation("TemplateAccessUser")
  templateGrants TemplateAccess[] @relation("TemplateAccessGrantedBy")

  mediaAssets MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([tenantOwnerId])
}

// ---------------------------------------------------------------------------
// Acesso a templates pré-definidos (Salão de Beleza, Energia Solar, etc.)
// ---------------------------------------------------------------------------
// Os templates em si são definidos em código (`src/lib/templates/registry.ts`),
// não no banco — este modelo só controla QUAIS clientes podem carregar QUAL
// template no Construtor de Fluxos. O MASTER sempre tem acesso a todos
// (não precisa de linha aqui); um CLIENTE só vê o botão de um template no
// Construtor se existir uma linha liberando aquele `templateKey` para ele.

model TemplateAccess {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("TemplateAccessUser", fields: [userId], references: [id], onDelete: Cascade)

  // Chave estável do template no registry (ex: "beauty-salon"), não um FK —
  // o catálogo de templates vive em código, não em tabela própria.
  templateKey String

  grantedById String?
  grantedBy   User?   @relation("TemplateAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, templateKey])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Configurações do robô (por cliente/tenant)
// ---------------------------------------------------------------------------

model Config {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // API Key da OpenAI do cliente, armazenada criptografada (AES-256-GCM) — nunca em texto puro
  openaiApiKeyEncrypted String?
  openaiApiKeyLast4     String? // últimos 4 caracteres, só para exibição ("sk-...ab12")

  // Prompt de sistema geral do robô
  systemPrompt String @default("Você é um assistente virtual educado e objetivo. Responda de forma clara e curta.")

  model            String  @default("gpt-4o-mini")
  temperature      Float   @default(0.7)
  aiEnabledDefault Boolean @default(true) // valor padrão do toggle de IA para novas conversas

  // Chave geral de IA do tenant: quando false, o motor de fluxo NÃO responde
  // a ninguém automaticamente — nem contatos novos — independente do
  // `Chat.aiEnabled` de cada conversa individual. É o "disjuntor mestre";
  // os toggles por conversa continuam existindo por baixo, só não têm efeito
  // enquanto esta chave estiver desligada.
  aiGloballyEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Conexão com o WhatsApp (pareamento via QR Code)
// ---------------------------------------------------------------------------

model WhatsappConnection {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      WhatsappStatus @default(DISCONNECTED)
  phoneNumber String?

  // QR code atual (data URL base64), atualizado pelo serviço externo (Baileys/whatsapp-web.js)
  // via webhook -> POST /api/whatsapp/qr
  qrCode      String? @db.Text
  qrExpiresAt DateTime?

  // Identificador da sessão no serviço externo responsável por manter o socket com o WhatsApp
  externalSessionId String?

  lastConnectedAt    DateTime?
  lastDisconnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Integração Google (Calendar + Sheets) — usada pelos blocos "Agenda: Buscar
// Horários" / "Agenda: Confirmar Agendamento" do Construtor de Fluxos.
// Conexão via OAuth2 (ver `src/lib/google-api.ts`): o refresh token guardado
// aqui permite ao motor de fluxo consultar/criar eventos numa agenda (a
// própria ou uma compartilhada, ex: a do gestor comercial) e gravar linhas
// numa planilha, sem depender de nenhuma ferramenta externa (n8n/Zapier).
// ---------------------------------------------------------------------------

model GoogleIntegration {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // E-mail da conta Google que autorizou a conexão — só para exibição.
  googleEmail String?

  // Refresh token criptografado (AES-256-GCM, ver `src/lib/encryption.ts`) —
  // é ele que permite ao servidor obter novos access tokens sozinho,
  // indefinidamente, sem o usuário precisar refazer o consentimento.
  refreshTokenEncrypted String @db.Text

  // Agenda a consultar/criar eventos — pode ser "primary" (a própria) ou o
  // e-mail de uma agenda compartilhada com a conta conectada (ex: a do
  // gestor comercial, quando ele deu acesso de edição pelo Google Calendar).
  calendarId String  @default("primary")
  timezone   String  @default("America/Sao_Paulo")

  // Planilha (Google Sheets) onde os leads qualificados são registrados.
  spreadsheetId     String?
  leadsSheetName    String  @default("Leads")
  sessionsSheetName String  @default("Sessoes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Fluxos visuais (React Flow) — estilo n8n
// ---------------------------------------------------------------------------

model Flow {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean @default(false)

  // Estrutura completa do React Flow (nodes + edges) serializada como JSON
  nodes Json @default("[]")
  edges Json @default("[]")

  version Int @default(1)

  sessions FlowSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Sessão de fluxo — posição de cada contato dentro do grafo de um Flow
// ---------------------------------------------------------------------------

model FlowSession {
  id     String @id @default(cuid())
  userId String // tenant dono do fluxo/conexão de WhatsApp
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  flowId String
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)

  contactPhone String // número do contato (com DDI), ex: "5511999998888"

  // Id do node do React Flow onde o contato está parado (null = ainda não iniciou)
  currentNodeId String?

  // Variáveis capturadas ao longo da conversa (ex: { nome: "Maria", servico: "Corte" })
  variables Json @default("{}")

  status FlowSessionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um contato tem no máximo uma sessão ativa por tenant
  @@unique([userId, contactPhone])
  @@index([userId, status])
  @@index([flowId])
}

// ---------------------------------------------------------------------------
// Live Chat / Central de Atendimento
// ---------------------------------------------------------------------------

model Chat {
  id     String @id @default(cuid())
  userId String // tenant dono da conversa
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contactName  String
  contactPhone String
  contactAvatarUrl String?

  status ChatStatus @default(OPEN)

  // Toggle por conversa: quando false, a IA para de responder e um humano assume
  aiEnabled Boolean @default(true)

  // Etapa no funil/Kanban de atendimento (ver /pipeline). Movida
  // automaticamente pelo motor de fluxo em dois pontos (handoff humano e
  // detecção de cliente recorrente — ver `flow-engine.ts`) e manualmente
  // pelo operador arrastando o card entre colunas.
  pipelineStage PipelineStage @default(PRIMEIRO_ATENDIMENTO)

  lastMessageAt DateTime  @default(now())
  lastMessagePreview String?
  unreadCount   Int       @default(0)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um contato tem no máximo uma conversa por tenant (usado por flow-engine.ts
  // para localizar/criar a conversa ao receber uma mensagem via webhook).
  @@unique([userId, contactPhone])
  @@index([userId, status])
  @@index([userId, lastMessageAt])
  @@index([userId, pipelineStage])
}

model Message {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  direction MessageDirection
  sender    MessageSender
  content   String           @db.Text
  mediaUrl  String?

  // ID da mensagem no provedor do WhatsApp (para status de entrega/leitura)
  externalId String?

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

// ---------------------------------------------------------------------------
// Auditoria (ex: MASTER criou/desativou cliente, resetou senha, etc.)
// ---------------------------------------------------------------------------

model AuditLog {
  id     String  @id @default(cuid())
  // Nulo quando a conta do autor foi excluída depois (ex: dono excluindo um
  // funcionário desligado) — nesse caso o registro sobrevive mesmo assim,
  // usando o snapshot abaixo. `onDelete: SetNull` em vez de `Cascade` de
  // propósito: apagar quem fez a ação NÃO deve apagar a prova do que foi
  // feito, que é justamente o cenário em que esse histórico mais importa.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Snapshot do autor no momento da ação, pra o histórico continuar legível
  // (nome, papel) mesmo que a conta seja excluída depois.
  actorName String
  actorRole Role

  // Preenchido só quando o autor é um FUNCIONARIO — aponta pro dono do
  // tenant (User.id) dono da ação, permitindo listar "só o que a equipe
  // fez" sem depender de um JOIN vivo com `User` (que se perderia se o
  // funcionário fosse excluído). Ações do próprio dono/MASTER (ex:
  // EMPLOYEE_CREATED) ficam com isso nulo de propósito — não aparecem no
  // histórico da equipe.
  tenantOwnerId String?

  action  String // ex: "CLIENT_CREATED", "CLIENT_DEACTIVATED", "PASSWORD_RESET"
  target  String? // id do recurso afetado
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantOwnerId])
}

// ---------------------------------------------------------------------------
// Mídia recebida via WhatsApp (fotos enviadas por contatos durante um fluxo)
// ---------------------------------------------------------------------------
// A Evolution API entrega mídia de mensagem (imagem/áudio/etc.) como bytes já
// decriptados via `/chat/getBase64FromMediaMessage` — não como uma URL
// pública utilizável (a URL crua do Baileys é criptografada e expira). Como
// o tenant ainda não tem um bucket de object storage próprio configurado,
// guardamos os bytes aqui e servimos via `GET /api/media/[id]` (rota pública,
// fora do middleware de sessão — o link precisa abrir direto no WhatsApp da
// recepcionista do salão, sem exigir login). Se o volume de mídia crescer
// muito, migrar para um bucket externo (S3/Supabase Storage) é o próximo
// passo natural, sem precisar mudar o restante do fluxo.
model MediaAsset {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mimetype String
  data     Bytes

  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Lock de processamento por contato
// ---------------------------------------------------------------------------
// Evita condição de corrida quando o mesmo contato manda mensagens em
// rajada (cada mensagem recebida dispara uma invocação própria do webhook,
// potencialmente em paralelo): sem isso, duas chamadas concorrentes podem
// ler o mesmo estado "velho" da FlowSession, cada uma processar sem saber da
// outra, e a que terminar por último sobrescreve o resultado da primeira —
// causando respostas duplicadas/contraditórias da IA. Não tem relação com
// nenhum outro model (`userId`/`contactPhone` bastam pra identificar o
// contato), então não é uma FK — é só uma tabela de "reserva" temporária.
model ContactProcessingLock {
  id           String   @id @default(cuid())
  userId       String
  contactPhone String
  // Expira sozinho — se uma chamada travar/crashar antes de liberar o lock
  // no `finally`, o próximo contato a escrever não fica bloqueado pra
  // sempre esperando um lock que nunca vai ser liberado manualmente.
  lockedUntil  DateTime

  @@unique([userId, contactPhone])
}
